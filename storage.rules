rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Firestore の admins/{uid} と同じ判定（role 未設定は "all" 扱い）
    function canManage(site) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.get('role', 'all') in [site, 'all'];
    }

    function isImageUnder10MB() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024;
    }

    // フルーツとやさい畑のイベント画像
    match /events/{allPaths=**} {
      allow read: if true;
      allow create, update: if canManage('fruitshatake') && isImageUnder10MB();
      allow delete: if canManage('fruitshatake');
    }

    // 花野菜農園の画像
    match /hanayasai/{allPaths=**} {
      allow read: if true;
      allow create, update: if canManage('hanayasai') && isImageUnder10MB();
      allow delete: if canManage('hanayasai');
    }
  }
}
